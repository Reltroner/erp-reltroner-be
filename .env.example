APP_NAME="Reltroner ERP Backend"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://erp.reltroner.com
FRONTEND_APP_URL=https://erp.reltroner.com
ADMIN_APP_URL=https://admin.erp.reltroner.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erp_reltroner
DB_USERNAME=postgres
DB_PASSWORD=

KEYCLOAK_BASE_URL=https://sso.reltroner.com
KEYCLOAK_ALLOWED_REALMS=reltroner-erp,reltroner-admin
KEYCLOAK_EXPECTED_AUDIENCE=erp-reltroner-be
KEYCLOAK_ALLOWED_ALGORITHMS=RS256
KEYCLOAK_ADMIN_REALM=reltroner-admin
KEYCLOAK_ADMIN_REQUIRED_REALM_ROLE=erp-admin
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=3600
KEYCLOAK_CLOCK_LEEWAY_SECONDS=60

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
